# Скопируй в .env.local (или .env) и впиши свой ключ DeepSeek:
# https://platform.deepseek.com — .env и .env.local в git не попадают.
# Файлы ищутся в рабочем каталоге и выше по дереву; переменная окружения
# важнее файла.

DEEPSEEK_API_KEY=

# Необязательно — значения по умолчанию.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Источники для инструментов; ключей не требуют.
# WIKIPEDIA_BASE_URL=https://ru.wikipedia.org
# GBIF_BASE_URL=https://api.gbif.org/v1
